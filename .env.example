# Public site URL. HTTPS enables Wallet auto-updates (webServiceURL); http://localhost passes don't update.
NEXT_PUBLIC_SITE_URL=https://gitcard.cospel.ar

# Neon Postgres (Vercel Marketplace). Apply schema.sql once: pnpm db:schema
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs session cookies and encrypts stored GitHub tokens. openssl rand -base64 32
# Rotating it signs everyone out and makes stored tokens unreadable (daily sync stops until they sign in again).
APP_SECRET=
# Vercel Cron sends it to /api/cron/sync. openssl rand -base64 32
CRON_SECRET=

# GitHub OAuth App (github.com/settings/developers). Callback: <site>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Apple Wallet signing, same Pass Type ID as Cospel. Paths to PEM files locally, or the PEM as one
# base64 line on Vercel (base64 -w0 secrets/pass.pem). Server-only: never prefix with NEXT_PUBLIC_.
PASS_TYPE_IDENTIFIER=pass.ar.cospel.card
APPLE_TEAM_IDENTIFIER=8Y4WVDDU45
PASS_SIGNER_CERT=./secrets/pass.pem
PASS_SIGNER_KEY=./secrets/pass.key
PASS_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=./secrets/wwdr.pem
